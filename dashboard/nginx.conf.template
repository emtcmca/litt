server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy /api and /health to the backend Cloud Run service.
    # BACKEND_URL is injected at container startup via envsubst.
    location /api/ {
        proxy_pass BACKEND_URL_PLACEHOLDER/api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
    }

    location /health {
        proxy_pass BACKEND_URL_PLACEHOLDER/health;
        proxy_set_header Host $http_host;
    }

    # SPA routing — all non-file paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Aggressive caching for versioned static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
